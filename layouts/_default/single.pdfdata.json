{{- /* PDF-data van één norm: invoer voor scripts/pdf-build.mjs (pdfkit).
     Alleen normpagina's voeren dit outputformat (front matter van
     content/normen/_index.md). De body is de onbewerkte .Content met
     genummerde voorschriften; alle verdere bewerkingen (backrefs weg,
     voetnoot-items plat, kop "Bronnen") doet de walker in
     scripts/pdf-html.mjs, op een echte DOM in plaats van met replaceRE. */ -}}
{{- $kern := "" -}}{{- with .Params.kern }}{{ $kern = . | markdownify }}{{ end -}}
{{- dict
  "kind" "norm"
  "titel" .Title
  "norm_id" (string .Params.norm_id)
  "kern_html" $kern
  "kern_bron_html" (partial "kern-bron-html.html" .)
  "body_html" (partial "nummer-voorschriften.html" (dict "content" .Content "norm_id" .Params.norm_id))
  "url" .Permalink
  "site_url" site.Home.Permalink
  "versie" (site.Params.versie | default "")
  "site_titel" site.Title
  "taal" (or site.Language.LanguageCode "nl-NL")
  | jsonify -}}
