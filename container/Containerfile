FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS build
ARG HUGO_VERSION=0.162.1
ARG HUGO_SHA256=4bfcdb092d0306586f1b72e5687787ead053faab2d71f09951d3c5fecde66873
RUN apk add --no-cache git wget tar \
  && wget -qO /tmp/hugo.tar.gz "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_${HUGO_VERSION}_linux-amd64.tar.gz" \
  && echo "${HUGO_SHA256}  /tmp/hugo.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/hugo.tar.gz -C /usr/local/bin \
  && rm /tmp/hugo.tar.gz \
  && hugo version
WORKDIR /src
COPY . .
ARG BASE_URL=
# Release-tag (git describe) doorgegeven vanuit de workflow; voedt de PDF-export
# via HUGO_PARAMS_VERSIE → site.Params.versie. Leeg → Hugo-default uit hugo.yaml.
ARG VERSIE=
RUN if [ -n "$VERSIE" ]; then export HUGO_PARAMS_VERSIE="$VERSIE"; fi; \
    if [ -n "$BASE_URL" ]; then \
      hugo --minify --baseURL "$BASE_URL"; \
    else \
      hugo --minify; \
    fi

FROM nginxinc/nginx-unprivileged:stable-alpine-slim@sha256:e88d990b349df8cf4aa82f16642d7a23375016638c9ace4e5c6ca25028e62e65 AS runtime
# Patch Alpine-packages onafhankelijk van de (soms achterlopende) base-image
# rebuild; houdt de Trivy-scan groen bij CVE's die Alpine al gefixt heeft.
# Werkt alleen als deze laag ook echt opnieuw draait: de workflow zet
# `no-cache-filters: runtime`, anders komt de upgrade uit de GHA-cache en
# blijft de oude openssl staan (CVE-2026-14456, 26 augustus 2026).
# Let op: deze upgrade vervangt nginx door de Alpine-build, die prefix
# /var/lib/nginx heeft. Die directory is 0750 en van uid 101, terwijl ZAD
# de pod met een willekeurige UID draait — zonder chmod faalt nginx op het
# default-logpad nog voordat hij nginx.conf (met expliciete logpaden) leest.
USER root
RUN apk upgrade --no-cache \
  && if [ -d /var/lib/nginx ]; then chmod 755 /var/lib/nginx; fi
USER 101
COPY --from=build /src/public/ /usr/share/nginx/html/
COPY container/nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080
